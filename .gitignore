# Local caches / machine-specific files
/usercache.json
/fabricloader.log
/config/skinrestorer/mojang_profile_cache.json
/server-secrets/yt-dlp/*.cookies.txt

# Temp files
/.tmp/
/tmp/
*.tmp
/scripts/.deps/
/scripts/__pycache__/

