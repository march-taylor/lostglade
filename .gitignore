# Generated packs/artifacts
/polymer/resource_pack.zip

# Bot client runtime outputs
/run-renderer-bot/.fabric/
/run-renderer-bot/logs/
/run-renderer-bot/debug/
/run-renderer-bot/crash-reports/
/run-renderer-bot/downloads/
/run-renderer-bot/polymer/resource_pack.zip
/run-renderer-bot/options.txt
/run-renderer-bot/servers.dat
/run-renderer-bot/servers.dat_old
